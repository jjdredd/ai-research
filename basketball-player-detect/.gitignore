# python
.venv/
__pycache__/

# local agent/session artifacts
.pi/

# model weights (downloaded on first run, not in git)
*.pt

# test footage: open-license clips live in clips/ but are downloaded, not
# committed (see clips/MANIFEST.md for sources + MANIFEST.sha256 for integrity)
clips/*.ogv
clips/*.webm
clips/*.mp4

# run outputs (regeneratable; committed only when explicitly snapshotted)
out/

# v0.1 bench: staged downloads (SportsMOT tars etc.) must never be committed
# (CC BY-NC 4.0, non-redistributable) — see docs/07
bench/_staging/
bench/mini-2026-10/*
!bench/mini-2026-10/README.md
bench/_eval/
bench/_results/
!bench/mini-2026-10/labels/
bench/mini-2026-10/labels/*
!bench/mini-2026-10/labels/label.html
